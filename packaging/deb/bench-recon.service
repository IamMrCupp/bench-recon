[Unit]
# Installed dormant: the package never enables or starts this. Turn it on with
# `bench-setup`, or `sudo bench-recon set-password` then
# `sudo systemctl enable --now bench-recon`.
Description=bench recon (engagement record web app and API)
Documentation=https://github.com/IamMrCupp/bench-recon
After=network-online.target
Wants=network-online.target

[Service]
User=bench-recon
Group=bench-recon
# The data folder: the database and artifact blobs. systemd creates it,
# owned by the service user.
StateDirectory=bench-recon
StateDirectoryMode=0750
Environment=BENCHRECON_DATA_DIR=/var/lib/bench-recon
# Loopback. It holds client engagement data: keep it there. (settings.env can
# override BENCHRECON_HOST, but bench-setup never offers to.)
Environment=BENCHRECON_HOST=127.0.0.1
Environment=BENCHRECON_PORT=8403
# The password hash and token, written by `sudo bench-recon set-password` and
# `sudo bench-recon new-token`. systemd reads it as root; the file stays
# root-only. Values win over the lines above.
EnvironmentFile=-/var/lib/bench-recon/settings.env
ExecStart=/opt/bench-recon/bin/bench-recon serve --host ${BENCHRECON_HOST} --port ${BENCHRECON_PORT}
Restart=on-failure
RestartSec=5
# Exit 2 is "no password set": restarting won't fix that, so don't loop.
RestartPreventExitStatus=2

# Give it as little of the system as it needs.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# A LAN web app needs sockets and nothing else exotic: TCP in both families,
# plus AF_UNIX for glibc's resolver/journal plumbing.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# @system-service covers a Python web server; native-only stops 32-bit
# syscall-table tricks on a 64-bit host.
SystemCallFilter=@system-service
SystemCallArchitectures=native
# Runs as an unprivileged user on an unprivileged port — no capabilities at all.
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes
RestrictRealtime=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
# The service can see only its own /proc entries; host tooling is unaffected.
ProtectProc=invisible
ProcSubset=pid
# Everything it writes (the database, the artifacts) is service-private.
UMask=0077

[Install]
WantedBy=multi-user.target
