# Keep the build context small and never ship local state into the image.
.git/
.github/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Local data — must never reach an image layer. These hold sensitive records.
bench-recon.db
bench-recon.db-*
artifacts/
.env

.claude/
.DS_Store
